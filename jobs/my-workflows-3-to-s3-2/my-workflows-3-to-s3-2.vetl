      "source": "%%pyspark default.spark\nimport sys\nfrom pyspark.context import SparkContext\nfrom pyspark.sql import SparkSession\n",
      "execution_count": 0,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": "%%pyspark default.spark\nsc = SparkContext.getOrCreate()\nspark = SparkSession.builder.getOrCreate()\n",
      "execution_count": 0,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": "%%pyspark default.spark\n# Script generated for node S3DataSource\nS3DataSource_node_s3_source = spark.read.format(\"text\").load(\"s3://amazon-sagemaker-027024089510-us-west-2-635znel7hip47k/shared/workflows/my-workflows-3.yaml\")",
      "execution_count": 0,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": "%%pyspark default.spark\n# Script generated for node S3DataSink\nS3DataSource_node_s3_source.write.format(\"csv\") \\\n    .option(\"header\", True) \\\n    .mode(\"append\") \\\n    .save(\"s3://sagemaker-glue-output-027024089510/my-workflows-3-2-output/\")",
      "execution_count": 0,
      "outputs": []
    }
