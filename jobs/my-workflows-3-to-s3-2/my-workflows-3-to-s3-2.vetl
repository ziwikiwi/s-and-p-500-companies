      "source": "%%configure -n default.spark\n{\n  \"number_of_workers\": 10,\n  \"session_type\": \"etl\",\n  \"glue_version\": \"5.0\",\n  \"worker_type\": \"G.1X\",\n  \"idle_timeout\": 60,\n  \"timeout\": 480,\n  \"--job-language\": \"python\",\n  \"--enable-glue-datacatalog\": \"true\",\n  \"--enable-metrics\": \"true\",\n  \"--enable-observability-metrics\": \"false\",\n  \"--enable-spark-ui\": \"true\",\n  \"--enable-auto-scaling\": \"true\",\n  \"--enable-lakeformation-fine-grained-access\": \"false\",\n  \"--smus-job-compute\": \"default.spark\",\n  \"--smus-orig-asset\": \"jobs/my-workflows-3-to-s3-2/my-workflows-3-to-s3-2.vetl\"\n}",
      "execution_count": 0,
      "outputs": []
